
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Registered Courses</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
</head>

<body class="bg-light">

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Registered Courses</h2>

        <a href="/student/dashboard" class="btn btn-secondary">
            Back to Dashboard
        </a>
    </div>

    <% if (registrations.length === 0) { %>

        <div class="alert alert-info">
            You haven't registered for any courses yet.
        </div>

    <% } else { %>

        <div class="table-responsive">

            <table class="table table-bordered table-striped bg-white">

                <thead class="table-dark">
                    <tr>
                        <th>Course Code</th>
                        <th>Course Title</th>
                        <th>Credits</th>
                        <th>Semester</th>
                        <th>Registration Date</th>
                    </tr>
                </thead>

                <tbody>

                    <% registrations.forEach(registration => { %>

                        <tr>
                            <td>
                                <%= registration.course?.courseCode || "N/A" %>
                            </td>

                            <td>
                                <%= registration.course?.title || "N/A" %>
                            </td>

                            <td>
                                <%= registration.course?.credits ?? "N/A" %>
                            </td>

                            <td>
                                <%= registration.course?.semester || "N/A" %>
                            </td>

                            <td>
                                <%= new Date(registration.registeredAt).toLocaleDateString() %>
                            </td>
                        </tr>

                    <% }) %>

                </tbody>

            </table>

        </div>

    <% } %>

</div>

</body>
</html>
